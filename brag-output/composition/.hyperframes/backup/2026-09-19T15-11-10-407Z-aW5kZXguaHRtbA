        if (typeof AUDIO_DATA === "undefined") return;
        const bgA = document.getElementById("glow-a");
        const logoGlow = document.getElementById("glow5-audio");
        const winners = document.querySelectorAll(".winner-glow-audio");
        const avg = (b, i, j) => { let s = 0; for (let k = i; k <= j; k++) s += b[k]; return s / (j - i + 1); };
        const total = Math.min(AUDIO_DATA.totalFrames, 30 * AUDIO_DATA.fps);
        for (let f = 0; f < total; f++) {
          tl.call(((fr) => () => {
            const b = fr.bands;
            const bass = avg(b, 0, 1), all = avg(b, 0, 15), treble = avg(b, 12, 14);
            gsap.set(bgA, { scale: 1 + 0.06 * bass, opacity: 0.7 + 0.3 * all });
            gsap.set(logoGlow, { scale: 1 + 0.07 * bass, opacity: 0.6 + 0.4 * treble });
            gsap.set(winners, { opacity: 0.35 + 0.65 * all });
          })(AUDIO_DATA.frames[f]), [], f / AUDIO_DATA.fps);
        }
      })();

      window.__timelines["brag"] = tl;
    </script>
  </body>
</html>
